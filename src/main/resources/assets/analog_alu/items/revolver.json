{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "analog_alu:item/revolver"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:model",
        "model": "analog_alu:item/revolver_aim"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "analog_alu:item/revolver_3d"
      }
    }
  }
}
