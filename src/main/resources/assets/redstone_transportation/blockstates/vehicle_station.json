{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "active": "false"
      },
      "apply": {
        "model": "redstone_transportation:block/vehicle_station"
      }
    },
    {
      "when": {
        "facing": "north",
        "active": "true"
      },
      "apply": {
        "model": "redstone_transportation:block/vehicle_station_active"
      }
    },
    {
      "when": {
        "facing": "east",
        "active": "false"
      },
      "apply": {
        "model": "redstone_transportation:block/vehicle_station",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "active": "true"
      },
      "apply": {
        "model": "redstone_transportation:block/vehicle_station_active",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "active": "false"
      },
      "apply": {
        "model": "redstone_transportation:block/vehicle_station",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "active": "true"
      },
      "apply": {
        "model": "redstone_transportation:block/vehicle_station_active",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "active": "false"
      },
      "apply": {
        "model": "redstone_transportation:block/vehicle_station",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "active": "true"
      },
      "apply": {
        "model": "redstone_transportation:block/vehicle_station_active",
        "y": 270
      }
    }
  ]
}
