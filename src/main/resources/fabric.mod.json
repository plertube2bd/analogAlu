{
  "schemaVersion": 1,
  "id": "modernization_world",
  "version": "${version}",
  "name": "Modernization World",
  "description": "Analog redstone computing, electric circuits, oil and semiconductors, firearms, diesel cars built from blocks, self-driving rail transport, 220 V factories and moving structures in one mod.",
  "license": "All Rights Reserved",
  "contact": {
    "sources": "https://github.com/plertube2bd/analogAlu"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.analogalu.AnalogAlu",
      "com.example.redstonetransportation.RedstoneTransportation",
      "com.example.modernizationworld.ModernizationWorld"
    ],
    "client": [
      "com.example.analogalu.WaferEditorClient",
      "com.example.redstonetransportation.client.RedstoneTransportationClient"
    ]
  },
  "mixins": [
    "analog_alu.mixins.json",
    "redstone_transportation.mixins.json"
  ],
  "provides": [
    "analog_alu",
    "redstone_transportation"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.3 <26.4",
    "java": ">=25",
    "fabric-api": "*"
  }
}
